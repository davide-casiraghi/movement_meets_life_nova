{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-gd": "*",
        "ext-json": "*",
        "andreiio/blade-remix-icon": "^1.0",
        "doctrine/dbal": "^3.5",
        "geoip2/geoip2": "^2.12",
        "guzzlehttp/guzzle": "^7.2",
        "guzzlehttp/psr7": "^2.1",
        "laravel-notification-channels/facebook-poster": "^6.0",
        "laravel-notification-channels/twitter": "^7.0",
        "laravel/framework": "^10.0",
        "laravel/jetstream": "^4.0",
        "laravel/sanctum": "^3.2",
        "laravel/tinker": "^2.8",
        "livewire/livewire": "^3.0",
        "mcamara/laravel-localization": "^1.8",
        "nesbot/carbon": "^2.67",
        "socialiteproviders/twitter": "^4.1",
        "spatie/calendar-links": "^1.4",
        "spatie/crawler": "^8.0",
        "spatie/laravel-backup": "^8.1",
        "spatie/laravel-honeypot": "^4.0",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-model-status": "^1.10",
        "spatie/laravel-permission": "^5.10",
        "spatie/laravel-searchable": "^1.11",
        "spatie/laravel-sitemap": "^7.0",
        "spatie/laravel-sluggable": "^3.1",
        "spatie/laravel-translatable": "^6.0",
        "spatie/schema-org": "^3.8",
        "stevebauman/location": "^6.3"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.13",
        "fakerphp/faker": "^1.13",
        "friendsofphp/php-cs-fixer": "^3.6",
        "larastan/larastan": "^2.0",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^7.0",
        "nunomaduro/phpinsights": "^2.1",
        "phpunit/phpunit": "^10.0",
        "slevomat/coding-standard": "^7.0",
        "spatie/laravel-ignition": "^2.0",
        "spatie/laravel-ray": "^1.9",
        "squizlabs/php_codesniffer": "^3.5"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
